@const-start

(defun view-static-thread () {

    (disp-render img-batt-level 10 83 colors-white-aa)

    (loopwhile t {

        ; Mode Symbol
        (var txt (cond
            ((eq stats-drive-mode 0)   "R")
            ((eq stats-drive-mode 1)   "N")
            ((eq stats-drive-mode 2)   "1")
            ((eq stats-drive-mode 3)   "2")
            ((eq stats-drive-mode 4)   "3")
            (true                      "-")
        ))
        (var imgbuf (img-buffer dm-pool 'indexed4 50 40))
        (ttf-text-center txt font-48 imgbuf)
        (disp-render imgbuf 10 8 colors-text-aa)
        ;/ mode

        ; motor temp
        (var imgbuf (img-buffer dm-pool 'indexed4 160 20))
        (var str (str-from-n stats-motor-temp "Motor Temp: %.2fC"))
        (ttf-text-center str font-16 imgbuf)
        (disp-render imgbuf 300 10 colors-text-aa)
        ; /motor temp

        ; Battery % bars
        (var (w h) '(42 18))
        (var imgbuf (img-buffer dm-pool 'indexed2 w h))
        (var imgbuf2 (img-buffer dm-pool 'indexed2 w h))
        (img-rectangle imgbuf 0 0 w h 1 '(rounded 2) '(filled))
        (looprange i 0 10 {
            (disp-render
                (if (> stats-bat-percent (* i 10)) imgbuf imgbuf2)
                14 (- 271 (* i 20)) colors-theme-2
            )
        })
        ; /battery bars

        ; Batt % text
        (var imgbuf (img-buffer dm-pool 'indexed4 40 15))
        (var str (str-from-n stats-bat-percent "%d%%"))
        (ttf-text-center str font-16 imgbuf)
        (disp-render imgbuf 16 299 colors-text-aa)
        ; /bat percentage

        ; Battery volts
        (var imgbuf (img-buffer dm-pool 'indexed4 60 15))
        (var str (str-from-n stats-bat-voltage "%.1fV"))
        (ttf-text-center str font-16 imgbuf)
        (disp-render imgbuf 6 59 colors-text-aa)
        ; /battery volts

        ; Speed & Watts & Amps
        (var imgbuf (img-buffer dm-pool 'indexed4 160 15))
        (ttf-text imgbuf 10 10 '(0 1 2 3) font-16 "mph")
        (disp-render imgbuf 80 30 colors-text-aa)

        (img-clear imgbuf)
        (ttf-text imgbuf 10 10 '(0 1 2 3) font-16 "watts")
        (disp-render imgbuf 80 140 colors-text-aa)

        (img-clear imgbuf)
        (ttf-text imgbuf 10 10 '(0 1 2 3) font-16 "amps (bat/mot)")
        (disp-render imgbuf 80 260 colors-text-aa)

        ; some values are filtered out when below N in order to stabilize the display while in the near zero noise

        (var imgbuf (img-buffer dm-pool 'indexed4 250 90))
        (ttf-text-center (str-from-n (if (< (abs stats-speed) 1) 0 stats-speed) "%0.1f") font-90 imgbuf '(0 3))
        (disp-render imgbuf 120 35 colors-speed)

        (img-clear imgbuf) ; same size as last one
        (ttf-text-center (str-from-n (if (< (abs stats-watts) 25) 0 stats-watts)) font-90 imgbuf '(0 3))
        (disp-render imgbuf 120 155 colors-speed)

        (var imgbuf (img-buffer dm-pool 'indexed4 350 40))
        (var bat-amps (if (< (abs stats-battery-amps) 1) 0 stats-battery-amps))
        (var mot-amps (if (< (abs stats-motor-amps) 1) 0 stats-motor-amps))
        (var amps-str (str-join (list
            (str-from-n bat-amps "%.1f")
            " / "
            (str-from-n mot-amps "%.1f")
            )))
        (ttf-text-center amps-str font-48 imgbuf)
        (disp-render imgbuf 120 280 colors-text-aa)

        ; /speed&watts&amps

        (sleep 0.05)
    })
})
