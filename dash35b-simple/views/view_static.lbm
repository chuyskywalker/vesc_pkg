@const-start

(defun view-static-thread () {

    (disp-render img-batt-level 10 83 colors-white-aa)

    (loopwhile t {

;        (def stats-drive-mode 0)
;        (def stats-speed 0)
;        (def stats-bat-percent 0)
;        (def stats-motor-temp 0)
;        (def stats-watts 0)
;        (def stats-amps 0.0)
;        (def stats-bat-voltage 0.0)

        ; Mode Symbol
        (var txt (cond
            ((eq stats-drive-mode 0)   "R")
            ((eq stats-drive-mode 1)   "N")
            ((eq stats-drive-mode 2)   "1")
            ((eq stats-drive-mode 3)   "2")
            ((eq stats-drive-mode 4)   "3")
            (true                      "-")
        ))

        (var imgbuf (img-buffer dm-pool 'indexed4 50 40))
        (img-clear imgbuf)

        (ttf-text-center txt font-48 imgbuf)
        (disp-render imgbuf 10 8 colors-text-aa)
        ;/ mode

        (var imgbuf (img-buffer dm-pool 'indexed4 160 15))
        (img-clear imgbuf)
        (var str (str-from-n stats-motor-temp "Motor Temp: %dC"))
        (ttf-text-center str font-16 imgbuf)
        (disp-render imgbuf 300 10 colors-text-aa)
        ; /motor temp

        ; Battery % bars
        (var (w h) '(42 18))
        (var imgbuf (img-buffer dm-pool 'indexed2 w h))
        (var imgbuf2 (img-buffer dm-pool 'indexed2 w h))
        (img-rectangle imgbuf 0 0 w h 1 '(rounded 2) '(filled))

        (looprange i 0 10 {
            (disp-render
                (if (> stats-bat-percent (* i 10)) imgbuf imgbuf2)
                14 (- 271 (* i 20)) colors-theme-2
            )
        })
        ; /battery bars

        ; Batt %
        (setq imgbuf (img-buffer dm-pool 'indexed4 40 15))
        (img-clear imgbuf)
        (var str (str-from-n stats-bat-percent "%d%%"))
        (ttf-text-center str font-16 imgbuf)
        (disp-render imgbuf 16 299 colors-text-aa)
        ; /bat percentage

        ; Battery volts
        (var imgbuf (img-buffer dm-pool 'indexed4 60 15))
        (img-clear imgbuf)
        (var str (str-from-n stats-bat-voltage "%.1fV"))
        (ttf-text-center str font-16 imgbuf)
        (disp-render imgbuf 6 59 colors-text-aa)
        ; /battery volts

        ; Speed & Watts
        (var imgbuf (img-buffer dm-pool 'indexed4 50 15))
        (img-clear imgbuf)
        (ttf-text imgbuf 10 10 '(0 3) font-16-2c "mph")
        (disp-render imgbuf 80 40 colors-speed)

        (var imgbuf (img-buffer dm-pool 'indexed4 50 15))
        (img-clear imgbuf)
        (ttf-text imgbuf 10 10 '(0 1 2 3) font-16 "watts")
        (disp-render imgbuf 80 170 colors-speed)

        (var imgbuf (img-buffer dm-pool 'indexed4 50 15))
        (img-clear imgbuf)
        (ttf-text imgbuf 10 10 '(0 1 2 3) font-16 "amps")
        (disp-render imgbuf 80 280 colors-speed)


        (var imgbuf (img-buffer dm-pool 'indexed4 250 90))
        (img-clear imgbuf)
        (ttf-text-center (str-from-n stats-speed) font-90 imgbuf '(0 3))
        ;(ttf-text imgbuf 0 90 '(0 3) font-90 (str-from-n stats-speed))
        (disp-render imgbuf 120 55 colors-speed)

        (var imgbuf (img-buffer dm-pool 'indexed4 250 90))
        (img-clear imgbuf)
        (ttf-text-center (str-from-n (if (< (abs stats-watts) 25) 0 stats-watts)) font-90 imgbuf '(0 3))
        ;(ttf-text imgbuf 0 90 '(0 3) font-90 (str-from-n stats-watts))
        (disp-render imgbuf 120 185 colors-speed)

        (var imgbuf (img-buffer dm-pool 'indexed4 150 40))
        (img-clear imgbuf)
        (ttf-text-center (str-from-n (if (< (abs stats-amps) 1) 0 stats-amps)) font-48 imgbuf)
        (disp-render imgbuf 230 280 colors-text-aa)

        ; /speed

        (sleep 0.05)
    })
})
